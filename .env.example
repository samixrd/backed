# ══════════════════════════════════════════════════════════════
#  BACKED — environment template
#  Copy to `.env` (root) or `.env.local` (web/). Everything here
#  is OPTIONAL: market data is keyless public Binance REST, so
#  the scanner, screener, and MCP server run with zero config.
# ══════════════════════════════════════════════════════════════

# ── LLM synthesis for /api/intel deep-dive (optional; web/app/api/intel) ──
# Unset → /api/intel returns the raw metrics snapshot without AI narrative.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o-mini-2024-07-18

# ── Binance Agentic MCP client id (web/lib/mcp.ts, default: codex) ──
# Whitelisted public client id used to talk to agent.binance.com/mcp/agentic.
AUTH_CLIENT_ID=codex

# ── Free B.AI model for the Codex CLI agent loop (agentos-run.sh) ──
# Only needed if you run ./agentos-run.sh yourself.
BAI_API_KEY=
BAI_MODEL=qwen3.8-flash
