# Supabase (free tier) — set iff you want the production persistence path.
# Leave unset to fall back to LocalStore (JSON files in .backed-data/).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# OpenAI GPT-4o-mini reasoning (free-ish credits)
OPENAI_API_KEY=
GPT_MODEL=gpt-4o-mini

# Agent signing / meta
AGENT_ID=0xBACKED-Alpha
