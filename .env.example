# ══════════════════════════════════════════════════════════════
#  BACKED — environment template
#  Copy to `.env` and fill in what your path needs. Nothing else
#  is required to boot: missing keys fall back to safe defaults.
#
#  Quick paths:
#   • Web terminal + scanner (Vercel) ....... AZURE_* only
#   • 24/7 agent + onchain anchoring ........ AZURE_* + ANCHOR_*
#   • Supabase persistence .................. SUPABASE_* (else JSON store)
#   • Codex CLI agent loop (agentos-run.sh) . BAI_API_KEY
#   • Legacy OpenAI path (src/cli.ts) ....... OPENAI_API_KEY (optional)
# ══════════════════════════════════════════════════════════════

# ── LLM reasoning — Azure OpenAI (primary; src/reasoning.ts) ──
# Fallback order in code: Azure → B.AI → throw. At least one needed.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o-mini-2024-07-18
AZURE_OPENAI_API_VERSION=2024-10-21

# ── Free-model reasoning — B.AI (src/reasoning.ts + agentos-run.sh) ──
# Used by the Codex CLI loop and as second fallback for /api/run.
BAI_API_KEY=
BAI_MODEL=qwen3.8-flash

# ── Onchain proof anchor — BNB Smart Chain (src/anchor.ts, trade routes) ──
# Testnet key ONLY (never mainnet). Holds zero value; used solely to commit
# SHA-256 decision hashes as timestamp proofs. BACKED is non-custodial.
ANCHOR_PRIVATE_KEY=
ANCHOR_TO=0x0000000000000000000000000000000000000000

# ── Persistence — Supabase (src/store.ts) ──
# Unset → falls back to LocalStore (.backed-data/ JSON files).
# Use the project's `backed.*` schema (tables: provable_evidence,
# provable_ledger, provable_agent_facts).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Agent identity / legacy OpenAI path (src/cli.ts, src/verify.ts) ──
AGENT_ID=0xBACKED-Alpha
GPT_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ── MCP client (web/lib/mcp.ts) ──
# Binance agentic MCP client id; defaults to "codex" if unset.
AUTH_CLIENT_ID=codex
